DATABASE_URL=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://infinityconverter.com
APP_VERSION=7.2.2
ALLOWED_ORIGINS=https://infinityconverter.com,https://www.infinityconverter.com
MAX_FILE_MB=200
MAX_BATCH_FILES=20
MAX_TOTAL_UPLOAD_MB=200
MAX_PDF_PAGES=1000
MAX_OUTPUT_MB=200
MAX_OCR_PAGES=25
MAX_IMAGE_PIXELS=80000000
OCR_TIMEOUT_SECONDS=60
SUBPROCESS_TIMEOUT=180
MAX_CONCURRENT_CONVERSIONS=2
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_MB=300
MAX_ARCHIVE_RATIO=150
REQUEST_TIMEOUT_SECONDS=210
# Optional distributed rate-limit storage / future queue backend
REDIS_URL=
RATE_LIMIT_STORAGE_URI=
# Optional external conversion fallbacks
CLOUDCONVERT_API_KEY=
CONVERT_API_KEY=

# Product visibility switches. Keep false until public auth/billing are ready.
PUBLIC_AUTH_ENABLED=0
PUBLIC_BILLING_ENABLED=0

# AI — keep the key server-side only. Railway should store the real secret here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google / AdSense — fill only with values from your own Google accounts.
# Leave blank until AdSense approves/provisions the corresponding values.
# Both pub-123… and ca-pub-123… are accepted and normalized after validation.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_TOOL=
ADSENSE_SLOT_ARTICLE=
GOOGLE_SITE_VERIFICATION=

